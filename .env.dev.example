# Development server example. Copy values manually on the dev server.
# Do not commit real secrets.

POSTGRES_DB=guvende_dev
POSTGRES_USER=guvende_dev_user
POSTGRES_PASSWORD=replace-with-dev-database-password

JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=7d

BREVO_API_KEY=replace-with-dev-brevo-api-key
ONESIGNAL_APP_ID=
ONESIGNAL_REST_API_KEY=

CORS_ORIGINS=https://dev-api.guvende.app,http://localhost,http://localhost:3000,http://localhost:4200,http://localhost:4201,http://localhost:5173,capacitor://localhost
EARLY_ACCESS_ENABLED=true
